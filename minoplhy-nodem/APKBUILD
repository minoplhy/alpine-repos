# Contributor: Minoplhy <c@3qx.nl>
maintainer="Minoplhy <c@3qx.nl>"
pkgname=nodem
pkgver=0.2.1
pkgrel=0
pkgdesc="NodeManager + ECH Manager: multi-tenant monitoring, DNS failover, and TLS 1.3 ECH key manager"
url="https://github.com/minoplhy/nodem"
arch="x86_64 aarch64"
license="MIT"
makedepends="go>=1.26 npm"
install="$pkgname.pre-install $pkgname-agent.pre-install"
pkgusers="nodem nodem-agent"
pkggroups="nodem nodem-agent"
subpackages="$pkgname-openrc
	$pkgname-agent
	$pkgname-agent-openrc:agent_openrc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/minoplhy/nodem/archive/refs/tags/v$pkgver.tar.gz
	$pkgname.confd
	$pkgname.initd
	$pkgname-agent.confd
	$pkgname-agent.initd
	"
options="net !check" # check: no test suite

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

build() {
	cd "$builddir"/frontend
	npm install
	npm run build
	cd "$builddir"

	local _ldflags="-s -w -X github.com/minoplhy/nodem/internal/version.Version=v$pkgver"
	go build -ldflags="$_ldflags" -o bin/$pkgname ./cmd/nodem
	go build -ldflags="$_ldflags" -o bin/$pkgname-agent ./cmd/nodem-agent
}

package() {
	install -D -m 755 "$builddir"/bin/$pkgname "$pkgdir"/usr/bin/$pkgname
	install -D -m 755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -D -m 644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
	install -d -m 750 -o nodem -g nodem "$pkgdir"/var/lib/$pkgname

	install -D -m 755 "$builddir"/bin/$pkgname-agent "$pkgdir"/usr/bin/$pkgname-agent

	install -d -m 755 -o nodem -g nodem "$pkgdir"/var/log/$pkgname
	install -d -m 755 -o nodem-agent -g nodem-agent "$pkgdir"/var/log/$pkgname-agent
}

agent() {
	pkgdesc="nodem ECH edge agent"

	amove usr/bin/$pkgname-agent
	amove var/log/$pkgname-agent
	install -d -m 750 -o nodem-agent -g nodem-agent "$subpkgdir"/var/lib/$pkgname
}

agent_openrc() {
	pkgdesc="nodem ECH edge agent OpenRC scripts"

	install_if="openrc ${subpkgname%-openrc}=$pkgver-r$pkgrel"
	install -D -m 755 "$srcdir"/$pkgname-agent.initd "$pkgdir"/etc/init.d/$pkgname-agent
	install -D -m 644 "$srcdir"/$pkgname-agent.confd "$pkgdir"/etc/conf.d/$pkgname-agent
	amove etc/init.d/$pkgname-agent
	amove etc/conf.d/$pkgname-agent
}
