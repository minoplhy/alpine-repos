# HTTP server listening port for the Web UI dashboard and REST API (default: 8080)
export PORT=8080

# ECH SSH pull server ingress port for edge nodes (default: 34234, set to 0 to disable)
export ECH_SSH_PORT=34234

# URL path prefix if hosting nodem behind a reverse proxy subpath (e.g. /nodem or /monitor)
# Leave as / if hosting on root domain or dedicated port.
export BASE_PATH=/

# Enable verbose debug logging in stdout (true / false, default: false)
export DEBUG=false

# Custom OpenSSL 3.2+ / 4.x binary path with native ECH support (optional; auto-detected if omitted)
# export OPENSSL_PATH=/opt/openssl/bin/openssl

# Service daemon configuration
# export NODEM_USER="nodem"
# export NODEM_DATADIR="/var/lib/nodem"
# export NODEM_LOG_FILE="/var/log/nodem/nodem.log"
