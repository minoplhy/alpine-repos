b939d6c014c588d5a7c3ee823e5d94711948dbd72ab6250bc6822369b11ff59fd87c320dfdb4efecbd9f70c376cbcdae3efd41b118e41976ed2e37ab3179812b  opengist.initd
76bca5c90c88d77a39e45a92c0d8898c58194be32b2f6cbc00cd8ffa15be7f99d7716eb41786f815669800e6694f30556a9c435021bad05f6dafac44872e6a55  1.14.0-go-version.patch
"
