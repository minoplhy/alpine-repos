# Central nodem control plane server URL (e.g. http://<server-ip>:8080 or https://nodem.example.com)
export ECH_SERVER=http://127.0.0.1:8080

# Server root Ed25519 public key (REQUIRED)
# Pinned on the agent to cryptographically verify payload signatures from the control plane
# before staging TLS keys or executing proxy reload triggers.
# Obtain this key from the nodem Web UI (ECH -> Nodes -> Add Node / Reveal Token) or GET /api/ech/server-key
export ECH_SERVER_PUBLIC_KEY=replace_with_server_public_key

# Secret authentication token generated when registering this node in nodem
# (Found in the nodem Web UI: ECH -> Nodes -> Add Node / Reveal Token)
export ECH_TOKEN=replace_with_node_secret_token

# Pull transport mechanism: "https" (recommended) or "ssh"
export ECH_TRANSPORT=https

# Local directory where ECH configs and keys are staged (default: /var/lib/nodem)
# In multi-cluster setups, keys are written to /var/lib/nodem/cluster_<id>/
export ECH_STORAGE_DIR=/var/lib/nodem

# Reverse proxy handler: "nginx", "caddy", "haproxy", or "hook" (default: nginx)
export ECH_PROXY=nginx

# Init system for proxy reload service management: "auto", "systemd", or "openrc" (default: openrc)
export ECH_INIT_SYSTEM=openrc

# Polling frequency in seconds (default: 300 = 5 minutes)
export ECH_INTERVAL=300

# Proxy reload command override (optional)
# Overrides built-in reload logic for nginx, caddy, or haproxy:
# export ECH_RELOAD_CMD="rc-service nginx reload"

# Optional path to hook script (required if ECH_PROXY=hook)
# export ECH_HOOK_SCRIPT=""

# Optional SSH pull parameters (used when ECH_TRANSPORT=ssh)
export ECH_SSH_PORT=34234
# export ECH_SSH_KEY=/root/.ssh/id_ed25519

# Service daemon configuration
# export NODEM_AGENT_USER="root"
# export NODEM_AGENT_LOG_FILE="/var/log/nodem-agent/nodem-agent.log"
